      "id": "00000000-0000-4000-8000-000000000010",
      "name": "Your settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        200,
        480
      ],
      "notes": "Everything you may want to change lives here. exchanges: comma separated ids such as binance,okx (empty = all). listing_type: spot or futures (empty = both). keyword: only alert when the headline contains it (empty = no filter). language: en, zh or ko. Leave send_to_discord and log_to_sheet as false until you configure them."
    },
    {
      "parameters": {
        "url": "https://tokenearly.com/api/public/listings.json",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "days",
              "value": "={{ $json.lookback_days }}"
            },
            {
              "name": "exchange",
              "value": "={{ $json.exchanges }}"
            },
            {
              "name": "type",
              "value": "={{ $json.listing_type }}"
            },
            {
              "name": "limit",
              "value": "100"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "00000000-0000-4000-8000-000000000011",
      "name": "Fetch new listings",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        400,
        480
      ],
      "notes": "A free, public, read-only JSON feed of new token listings across 10 exchanges. No account and no API key. neverError is on so a bad response is handled by the next node instead of stopping the workflow."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "00000000-0000-4000-8000-000000000012",
              "leftValue": "={{ $json.count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "00000000-0000-4000-8000-000000000013",
      "name": "Feed returned items?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        620,
        480
      ],
      "notes": "Guard: the feed returns a count field, so an unreachable or empty response ends the run quietly instead of throwing further down."
    },
    {
      "parameters": {},
      "id": "00000000-0000-4000-8000-000000000014",
      "name": "Nothing new this run",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        840,
        680
      ],
      "notes": "Normal outcome most of the time. Nothing to do."
    },
    {
      "parameters": {
        "fieldToSplitOut": "items",
        "options": {}
      },
      "id": "00000000-0000-4000-8000-000000000015",
      "name": "Split into one item per listing",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        840,
        460
      ],
      "notes": "The feed returns one object with an items array; this turns it into one n8n item per listing."
    },
    {
      "parameters": {
        "operation": "removeItemsSeenInPreviousExecutions",
        "logic": "removeItemsWithAlreadySeenKeyValues",
        "dedupeValue": "={{ $json.permalink }}",
        "options": {}
      },
      "id": "00000000-0000-4000-8000-000000000016",
      "name": "Only listings not seen before",
      "type": "n8n-nodes-base.removeDuplicates",
      "typeVersion": 2,
      "position": [
        1060,
        460
      ],
      "notes": "Remembers each listing's permalink across executions, so restarts and overlapping windows never re-announce a listing."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "00000000-0000-4000-8000-000000000017",
              "leftValue": "={{ $('Your settings').first().json.exchanges || $json.exchange }}",
              "rightValue": "={{ $json.exchange }}",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "00000000-0000-4000-8000-000000000018",
      "name": "Matches your exchange filter?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1280,
        460
      ],
      "notes": "Passes everything when exchanges is empty in settings, because the left side then falls back to this listing's own exchange."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "00000000-0000-4000-8000-000000000019",
              "leftValue": "={{ ($json.title.en || '') + ' ' + ($json.title.zh || '') + ' ' + ($json.title.ko || '') }}",
              "rightValue": "={{ $('Your settings').first().json.keyword }}",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "00000000-0000-4000-8000-00000000001a",
      "name": "Matches your keyword filter?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1480,
        460
      ],
      "notes": "Passes everything when keyword is empty in settings. Matching runs against all three language titles at once."
    },
    {
      "parameters": {},
      "id": "00000000-0000-4000-8000-00000000001b",
      "name": "Skipped by your filters",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1480,
        680
      ],
      "notes": "Listings that did not match. Kept as a separate branch so you can see what was filtered out in the execution log."
    },
    {
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "00000000-0000-4000-8000-00000000001c",
              "name": "headline",
              "value": "={{ $json.title[$('Your settings').first().json.language] || $json.title.en || $json.title.zh || $json.title.ko }}",
              "type": "string"
            },
            {
              "id": "00000000-0000-4000-8000-00000000001d",
              "name": "symbols_text",
              "value": "={{ ($json.symbols || []).join(', ') }}",
              "type": "string"
            },
            {
              "id": "00000000-0000-4000-8000-00000000001e",
              "name": "type_label",
              "value": "={{ $json.type === 'futures' ? 'Futures' : 'Spot' }}",
              "type": "string"
            },
            {
              "id": "00000000-0000-4000-8000-00000000001f",
              "name": "minutes_old",
              "value": "={{ Math.max(0, Math.round((Date.now() - new Date($json.published_at).getTime()) / 60000)) }}",
              "type": "string"
            },
            {
              "id": "00000000-0000-4000-8000-000000000020",
              "name": "message",
              "value": "=<b>{{ $json.exchange_name }}</b> · {{ $json.type === 'futures' ? 'Futures' : 'Spot' }} listing\n{{ ($json.title[$('Your settings').first().json.language] || $json.title.en || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;') }}\n{{ ($json.symbols || []).length ? '\\n' + ($json.symbols || []).join('  ') + '\\n' : '' }}\n<a href=\"{{ $json.source_url || $json.permalink }}\">Original announcement</a>",
              "type": "string"
            }
          ]
        }
      },
      "id": "00000000-0000-4000-8000-000000000021",
      "name": "Prepare alert fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
