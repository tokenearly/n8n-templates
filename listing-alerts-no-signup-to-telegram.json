          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "00000000-0000-4000-8000-00000000002a",
      "name": "Also log to Google Sheets?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1900,
        720
